{
  "name": "halfcloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch backend/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "tsc -p backend/tsconfig.json",
    "start": "node dist/backend/server.js",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && vue-tsc -p frontend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.49",
    "@ai-sdk/vue": "^4.0.79",
    "ai": "^7.0.79",
    "cookie-parser": "^1.4.7",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "vue": "^3.5.41",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/dockerode": "^3.3.47",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^6.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.2.5"
  }
}
